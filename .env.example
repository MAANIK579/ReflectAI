# ReflectAI configuration
# Copy this file to .env and fill in real values as they become available.
# Nothing here should be hard-coded into application code.

# --- Development mode flags ---
# On Mac (no hardware yet): both should be true
# On Raspberry Pi (real hardware): both should be false
ESP32_MOCK_MODE=true
CAMERA_MOCK_MODE=true

# --- Database ---
DATABASE_PATH=data/reflectai.db

# --- ESP32 (only used when ESP32_MOCK_MODE=false) ---
ESP32_HOST=
ESP32_PORT=

# --- External services (added in later phases) ---
WEATHER_API_KEY=
WEATHER_CITY=New Delhi
WEATHER_LAT=28.6139
WEATHER_LON=77.2090
WEATHER_UNITS=celsius
NEWS_API_KEY=

# --- App ---
LOG_LEVEL=INFO
WAKE_PHRASE=Hey Aaina
